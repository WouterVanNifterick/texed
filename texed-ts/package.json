{
  "name": "texed-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:library && vite",
    "build": "pnpm build:library && pnpm typecheck && vite build",
    "build:library": "tsx scripts/build-patch-library.mts",
    "inventory:library": "tsx scripts/inventory-library.mts",
    "cli": "pnpm --filter @texed/cli start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "prepare": "cd .. && husky texed-ts/.husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -b && tsc -p tsconfig.test.json"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{css,json,md,html}": "prettier --write"
  },
  "dependencies": {
    "@texed/dx7-engine": "workspace:*",
    "@texed/dx7-format": "workspace:*",
    "@texed/synth-protocol": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
